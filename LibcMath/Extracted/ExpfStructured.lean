/-- `kd` rounded to an integer, for `|kd| < 2 ^ 24`. Adding and subtracting `2 ^ 23`, with the
sign of `kd`, gives an integer `k₀` near `kd`, which is corrected by one where it differs from
`kd` by more than one half. -/
def expfNearestInt (mode : IEEERoundingMode) (kd : Model .binary32) : Option (Model .binary32) := do
  let below ← nonNaN (Model.add kd f32(0xCB000000#32) mode)
  let above ← nonNaN (Model.add kd f32(0x4B000000#32) mode)
  let k₀ ← nonNaN (if Model.compare kd f32(0x0#32) == some .lt then
    Model.add below f32(0x4B000000#32) mode else Model.add above f32(0xCB000000#32) mode)
  let d ← nonNaN (Model.sub kd k₀ mode)
  if Model.compare d f32(0x3F000000#32) == some .gt then
    nonNaN (Model.add k₀ f32(0x3F800000#32) mode)
  else if Model.compare d f32(0xBF000000#32) == some .lt then
    nonNaN (Model.add k₀ f32(0xBF800000#32) mode)
  else some k₀

/-- The reduced argument `x - k / 128`. -/
def expfReduce (mode : IEEERoundingMode) (x k : Model .binary32) : Option (Model .binary32) := do
  let t ← nonNaN (Model.mul k f32(0x3C000000#32) mode)
  nonNaN (Model.sub x t mode)

/-- The polynomial `1 + r + r² / 2 + r³ / 6 + r⁴ / 24` with the coefficients of the code, by
Horner's rule. -/
def expfPoly (mode : IEEERoundingMode) (r : Model .binary64) : Option (Model .binary64) := do
  let t ← nonNaN (Model.mul r f64(0x3FA55555555EF243#64) mode)
  let p ← nonNaN (Model.add t f64(0x3FC555566668E5E7#64) mode)
  let t ← nonNaN (Model.mul p r mode)
  let p ← nonNaN (Model.add t f64(0x3FE000000000071C#64) mode)
  let t ← nonNaN (Model.mul p r mode)
  let p ← nonNaN (Model.add t f64(0x3FEFFFFFFFFFF777#64) mode)
  let t ← nonNaN (Model.mul p r mode)
  nonNaN (Model.add t f64(0x3FF0000000000000#64) mode)

/-- The result for the argument `x`, given the integer `k` nearest to `128 * x` (block 20): the
product of `exp (k / 128)`, from the two tables, and `expfPoly (x - k / 128)`. -/
def expfOfNearestInt (mode : IEEERoundingMode) (x k : Model .binary32) :
    Option (Model .binary32) := do
  let r ← expfReduce mode x k
  let n ← fptosi? 32 k
  let hi ← expM1[(((n + 0x3400#32).sshiftRight' 0x7#32).signExtend 64).toNat]?
  let lo ← expM2[((n &&& 0x7F#32).setWidth 64).toNat]?
  let r ← nonNaN (Model.cast .binary32 .binary64 r mode)
  let p ← expfPoly mode r
  let scale ← nonNaN (Model.mul f64(BitVec.ofNat 64 hi) f64(BitVec.ofNat 64 lo) mode)
  let y ← nonNaN (Model.mul scale p mode)
  some (Model.cast .binary64 .binary32 y mode)

/-- The computation of `expf` on the arguments it does not treat specially (blocks 15 to 21):
`exp x = exp (k / 128) * exp r` with `k` the integer nearest to `128 * x` and `r = x - k / 128`.
For `|128 * x| ≥ 2 ^ 24` the code takes `k = 128 * x`, which is an integer already. -/
def expfMain (mode : IEEERoundingMode) (x : Model .binary32) : Option (Model .binary32) := do
  let kd ← nonNaN (Model.mul x f32(0x43000000#32) mode)
  let k ← if Model.compare kd.abs f32(0x4B800000#32) == some .lt then expfNearestInt mode kd
    else nonNaN kd
  expfOfNearestInt mode x k

/-- The result of `expf` at the argument with bit pattern `0xC236BD8C` (block 1). -/
def expfSpecial (mode : IEEERoundingMode) : Model .binary32 :=
  Model.add (Model.mul f32(0xC236BD8C#32).neg f32(0x10000000#32) mode) f32(0x1E88452C#32) mode

/-- The computation of `expf` on the arguments for which it evaluates its polynomial, and at
`0xC236BD8C`. -/
def expfStructured (mode : IEEERoundingMode) (x : Model .binary32) : Option (Model .binary32) :=
  if x.toNatBits = 0xC236BD8C then some (expfSpecial mode) else expfMain mode x

end LibcMath.Extracted
